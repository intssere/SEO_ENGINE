{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm --filter @seo-engine/oauth-connection-manager build && node ./build.mjs && tsx ./src/lib/p8-8-w09c2g-build-provenance-cli.ts && node ./verify-build.mjs",
    "build:production": "pnpm run build",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "pnpm --filter @seo-engine/oauth-connection-manager build && AI_PROPOSAL_GENERATION_ENABLED=false AI_INTEGRATIONS_OPENAI_BASE_URL=http://127.0.0.1:9 AI_INTEGRATIONS_OPENAI_API_KEY=ci-test-key tsx --test src/lib/*.test.ts src/middlewares/*.test.ts",
    "test:scale": "tsx src/lib/load-scale-profile.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pilot:run": "node --enable-source-maps ./dist/pilot-runner.mjs",
    "test:p12-2-persistence-ephemeral": "tsx --test src/lib/first-party-crawl-persistence.ephemeral.test.ts",
    "test:p12-2-l6-durable-ephemeral": "tsx --test src/lib/p12-2-l2-durable-receipt-store.ephemeral.test.ts",
    "p12-2:crawl": "node --enable-source-maps ./dist/p12-2-crawl.mjs",
    "p12-2:live-operator": "node --enable-source-maps ./dist/p12-2-live-operator.mjs",
    "p12-2:l10-15-packet-014": "node --enable-source-maps ./dist/p12-2-l10-15-packet-014-live.mjs",
    "p12-2:l10-16-packet-014-preflight": "node --enable-source-maps ./dist/p12-2-l10-16-packet-014-preflight.mjs",
    "p12-2:l10-17-packet-014-post-run-cert": "node --enable-source-maps ./dist/p12-2-l10-17-packet-014-post-run-cert.mjs",
    "p12-2:l10-18-packet-014-finalization-repair": "node --enable-source-maps ./dist/p12-2-l10-18-packet-014-finalization-repair.mjs",
    "p12-2:l10-18-packet-014-post-repair-cert": "node --enable-source-maps ./dist/p12-2-l10-18-packet-014-post-repair-cert.mjs",
    "p12-2:l10-19-packet-014-preflight": "node --enable-source-maps ./dist/p12-2-l10-19-packet-014-preflight.mjs",
    "p12-2:l10-19-a-0011-apply": "node --enable-source-maps ./dist/p12-2-l10-19-a-0011-apply.mjs",
    "p12-2:l10-19-b-0011-post-cert": "node --enable-source-maps ./dist/p12-2-l10-19-b-0011-post-cert.mjs",
    "p12-2:l10-19-packet-014-expected-absence-disposition": "node --enable-source-maps ./dist/p12-2-l10-19-packet-014-expected-absence-disposition.mjs",
    "p12-2:l10-19-c-packet-014-post-disposition-cert": "node --enable-source-maps ./dist/p12-2-l10-19-c-packet-014-post-disposition-cert.mjs",
    "test:p8-8-w04-persistence-ephemeral": "tsx --test src/lib/p8-8-reservation-store.ephemeral.test.ts",
    "test:p8-8-w05-persistence-ephemeral": "tsx --test src/lib/p8-8-mutation-control-store.ephemeral.test.ts",
    "test:p8-8-w06-persistence-ephemeral": "tsx --test src/lib/p8-8-policy-preflight-store.ephemeral.test.ts",
    "test:p8-8-w07-persistence-ephemeral": "tsx --test src/lib/p8-8-policy-single-action-store.ephemeral.test.ts",
    "test:p8-8-w09b-evidence-ephemeral": "tsx --test src/lib/p8-8-w09b-readonly-acquisition.ephemeral.test.ts",
    "test:p12-2-l10-13b-persistence-ephemeral": "tsx --test src/lib/first-party-crawl-terminal-recovery.ephemeral.test.ts",
    "test:p12-2-l10-21-persistence-ephemeral": "tsx --test src/lib/first-party-crawl-expected-absence-persistence.ephemeral.test.ts",
    "test:p12-2-l10-23-comparable-baseline-ephemeral": "tsx --test src/lib/first-party-crawl-comparable-baseline.ephemeral.test.ts",
    "test:p12-2-l10-25-runtime-comparable-ephemeral": "tsx --test src/lib/first-party-crawl-comparable-baseline.ephemeral.test.ts",
    "test:p12-2-l10-27-postgres-certification-ephemeral": "tsx --test src/lib/p12-2-l10-27-packet-014-postgres-certification.ephemeral.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@seo-engine/oauth-connection-manager": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.23.4"
  }
}
