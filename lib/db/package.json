{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "bootstrap:runtime": "tsx src/bootstrap-runtime.ts",
    "test:bootstrap": "tsx --test src/runtime-bootstrap.test.ts",
    "test:p3-6": "tsx --test src/p3-6-observation-evidence-migration.test.ts",
    "test:p12-2": "tsx --test src/p12-2-first-party-crawl-migration.test.ts",
    "test:p8-8-w04": "tsx --test src/p8-8-w04-reservation-migration.test.ts",
    "test:p8-8-w05": "tsx --test src/p8-8-w05-mutation-control-migration.test.ts",
    "test:p8-8-w07": "tsx --test src/p8-8-w07-dispatch-migration.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6"
  }
}
