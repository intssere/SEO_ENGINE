FROM node:24.19.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app

ARG EXPECTED_CANONICAL_COMMIT
ARG EXPECTED_CANONICAL_TREE
ARG EXPECTED_SOURCE_BRANCH
ENV EXPECTED_CANONICAL_COMMIT=$EXPECTED_CANONICAL_COMMIT
ENV EXPECTED_CANONICAL_TREE=$EXPECTED_CANONICAL_TREE
ENV EXPECTED_SOURCE_BRANCH=$EXPECTED_SOURCE_BRANCH

RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/api-server run build:production
RUN test -s /app/artifacts/api-server/dist/p12-2-l7-2-0008-apply.mjs
RUN test -s /app/artifacts/api-server/dist/p12-2-l7-2-0008-apply.mjs.map
RUN test "$(sha256sum /app/lib/db/migrations/0008_first_party_crawl_l2_invocations.sql | awk '{print $1}')" = "a3604fc210374392426e1a75a1dacc3a89651942466ff4b6d76c620e120dd25b"

FROM node:24.19.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build --chown=node:node /app/artifacts/api-server/dist/p12-2-l7-2-0008-apply.mjs ./p12-2-l7-2-0008-apply.mjs
COPY --from=build --chown=node:node /app/artifacts/api-server/dist/p12-2-l7-2-0008-apply.mjs.map ./p12-2-l7-2-0008-apply.mjs.map
COPY --from=build --chown=node:node /app/lib/db/migrations/0008_first_party_crawl_l2_invocations.sql ./0008_first_party_crawl_l2_invocations.sql

USER node

CMD ["node", "--enable-source-maps", "/app/p12-2-l7-2-0008-apply.mjs"]
