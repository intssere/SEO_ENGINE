# Runtime
NODE_ENV=development

# Safety gate: must remain false until the Safety Engine and write-path certification tasks are complete.
PUBLIC_SITE_WRITES_ENABLED=false

# Database
DATABASE_URL=

# AI
OPENAI_API_KEY=

# Shopify Task #3 read-only connection.
# Use the permanent *.myshopify.com domain, not the storefront vanity domain.
# The app installation must grant read_products and read_content and MUST NOT grant write_* scopes.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07

# Google Task #5 read-only ingestion.
# OAuth implementations must request only readonly scopes for ingestion.
# Do not commit access/refresh tokens; store secrets outside source control.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GA4_PROPERTY_ID=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Reserved for later tasks.
OPENSEO_BASE_URL=
OPENSEO_API_KEY=
